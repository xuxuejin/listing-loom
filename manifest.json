{
  "manifest_version": 3,
  "name": "Listing Loom — 商品织录",
  "version": "0.1.0",
  "description": "采集商品页面信息，整理为可交给 AI 生成商品文案的本地草稿。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["https://*.gigab2b.com/*", "https://*.amazon.com/*", "https://generativelanguage.googleapis.com/*", "https://api.deepseek.com/*"],
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "action": {
    "default_title": "打开 Listing Loom",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": { "default_path": "index.html" }
}
